# Salin file ini jadi ".env" lalu isi dengan nilai dari Supabase Dashboard
# (Project Settings → API). VITE_SUPABASE_ANON_KEY itu "anon public" key —
# aman ditaruh di client, BUKAN service_role key (yang itu jangan pernah
# dipakai di kode frontend).

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
